# Copy to ~/.config/bob-live/live.env (outside this repo), chmod 600.
# Set LIVE_BIND to this machine's loopback or private Tailscale IP.
LIVE_BIND=127.0.0.1
LIVE_PORT=8787
# On remote agents replace the hostname with your private aggregator address.
BOB_LIVE_PUSH=http://aggregator.example.invalid:8787/api/node
# LIVE_TOKEN_FILE defaults to ~/.config/bob-live/token (chmod 600).
