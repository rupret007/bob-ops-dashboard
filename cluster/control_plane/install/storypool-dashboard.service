[Unit]
Description=StoryPool Dashboard
Documentation=https://github.com/rupret007/bob-ops-dashboard
After=network.target

# Local dashboard server on :8790 (localhost/tailnet requests only)
# Read-only status plus confirmed operator maintenance controls
# Accessible over Tailscale

[Service]
Type=simple
WorkingDirectory=__REPO_PATH__
Environment=PYTHONPATH=__REPO_PATH__
Environment=STORYPOOL_MACHINE=nucbox
Environment="PATH=/home/%u/bin:/home/%u/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/%u"
ExecStart=/usr/bin/python3 -m cluster.control_plane.dashboard --host 0.0.0.0 --port 8790

Restart=always
RestartSec=60

# Resource limits
Nice=10
MemoryMax=128M

[Install]
WantedBy=default.target
