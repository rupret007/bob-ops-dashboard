<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
StoryPool Karen Poller - Mac mini launchd plist

Runs every 10 minutes to:
- Auto-discover all rupret007 repos with open PRs (excluding never-touch repos)
- Label queued PRs with needs-karen
- Run gate on PRs with needs-karen label
- Write backlog report to ~/.local/share/storypool/backlog.md

Install: installed by install-all-mini.sh
Go-live: go-live-mini.sh (enables RunAtLoad)
-->
<dict>
    <key>Label</key>
    <string>com.storypool.karen-poller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>cluster.control_plane.local_karen.poller</string>
        <string>--once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__REPO_PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>STORYPOOL_INSTALL_DIR</key>
        <string>__REPO_PATH__</string>
        <key>STORYPOOL_MACHINE</key>
        <string>mini</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/karen/poller.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/karen/poller.log</string>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
