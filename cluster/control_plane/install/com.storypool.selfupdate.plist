<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>PYTHONPATH</key>
		<string>__REPO_PATH__</string>
		<key>STORYPOOL_INSTALL_DIR</key>
		<string>__REPO_PATH__</string>
		<key>STORYPOOL_MACHINE</key>
		<string>mini</string>
	</dict>
	<key>Label</key>
	<string>com.storypool.selfupdate</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-m</string>
		<string>cluster.control_plane.self_update</string>
		<string>--machine</string>
		<string>mini</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/share/storypool/selfupdate-launchd.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.local/share/storypool/selfupdate-launchd.log</string>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>WorkingDirectory</key>
	<string>__REPO_PATH__</string>
</dict>
</plist>
