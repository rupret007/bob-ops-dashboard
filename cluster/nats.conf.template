# Bob cluster NATS — generated by cluster/install-nats.sh
port: 4222
host: "127.0.0.1"

http: "127.0.0.1:8232"

jetstream {
  store_dir: "{{JS_STORE_DIR}}"
  max_mem_store: 268435456
  max_file_store: 2147483648
}

authorization {
  users = [
    # BEGIN GENERATED COORD ACL
    {
      user: coord
      password: "{{COORD_TOKEN}}"
      permissions: {
        publish: ["$KV.STORYPOOL_CLAIMS.>", "$JS.API.STREAM.INFO.KV_STORYPOOL_CLAIMS", "$JS.API.STREAM.MSG.GET.KV_STORYPOOL_CLAIMS", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS.>", "$KV.STORYPOOL_CLAIMS_RETRIES.>", "$JS.API.STREAM.INFO.KV_STORYPOOL_CLAIMS_RETRIES", "$JS.API.STREAM.MSG.GET.KV_STORYPOOL_CLAIMS_RETRIES", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS_RETRIES", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS_RETRIES.>"]
        subscribe: ["_INBOX_coord.>"]
      }
    }
    {
      user: coordop
      password: "{{COORDOP_TOKEN}}"
      permissions: {
        publish: ["$KV.STORYPOOL_CLAIMS.>", "$JS.API.STREAM.INFO.KV_STORYPOOL_CLAIMS", "$JS.API.STREAM.MSG.GET.KV_STORYPOOL_CLAIMS", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS.>", "$JS.API.STREAM.CREATE.KV_STORYPOOL_CLAIMS", "$JS.API.STREAM.UPDATE.KV_STORYPOOL_CLAIMS", "$KV.STORYPOOL_CLAIMS_RETRIES.>", "$JS.API.STREAM.INFO.KV_STORYPOOL_CLAIMS_RETRIES", "$JS.API.STREAM.MSG.GET.KV_STORYPOOL_CLAIMS_RETRIES", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS_RETRIES", "$JS.API.DIRECT.GET.KV_STORYPOOL_CLAIMS_RETRIES.>", "$JS.API.STREAM.CREATE.KV_STORYPOOL_CLAIMS_RETRIES", "$JS.API.STREAM.UPDATE.KV_STORYPOOL_CLAIMS_RETRIES"]
        subscribe: ["_INBOX_coordop.>"]
      }
    }
    # END GENERATED COORD ACL
    {
      user: mini
      password: "{{MINI_TOKEN}}"
      permissions: {
        publish: ["metrics.mini", "results.mini.>", "$JS.API.CONSUMER.INFO.JOBS.workers_mini", "$JS.API.CONSUMER.MSG.NEXT.JOBS.workers_mini", "$JS.ACK.JOBS.workers_mini.>"]
        subscribe: ["_INBOX_mini.>"]
      }
    }
    {
      user: nucbox
      password: "{{NUCBOX_TOKEN}}"
      permissions: {
        publish: ["metrics.nucbox", "results.nucbox.>", "jobs.>", "$JS.API.>", "$JS.ACK.JOBS.workers_nucbox.>"]
        subscribe: ["_INBOX_nucbox.>", "results.>"]
      }
    }
    {
      user: macbook
      password: "{{MACBOOK_TOKEN}}"
      permissions: {
        publish: ["metrics.macbook", "results.macbook.>", "$JS.API.CONSUMER.INFO.JOBS.workers_macbook", "$JS.API.CONSUMER.MSG.NEXT.JOBS.workers_macbook", "$JS.ACK.JOBS.workers_macbook.>"]
        subscribe: ["_INBOX_macbook.>"]
      }
    }
    {
      user: dashboard
      password: "{{DASHBOARD_TOKEN}}"
      permissions: {
        publish: []
        subscribe: ["metrics.>", "results.>"]
      }
    }
  ]
}
