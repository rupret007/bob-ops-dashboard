# Bob cluster NATS — generated by cluster/install-nats.sh
port: 4222
host: "127.0.0.1"

http: 8222
http_port: 8222

jetstream {
  store_dir: "{{JS_STORE_DIR}}"
  max_mem_store: 268435456
  max_file_store: 2147483648
}

authorization {
  users = [
    {
      user: mini
      password: "{{MINI_TOKEN}}"
      permissions: {
        publish: ["metrics.mini", "results.>", "$JS.API.>", "_INBOX.>"]
        subscribe: ["$JS.API.>", "$JS.ACK.>", "$JS.FC.>", "_INBOX.>"]
      }
    }
    {
      user: nucbox
      password: "{{NUCBOX_TOKEN}}"
      permissions: {
        publish: ["metrics.nucbox", "results.>", "jobs.>", "$JS.API.>"]
        subscribe: ["$JS.API.>", "$JS.ACK.>", "$JS.FC.>", "_INBOX.>", "results.>"]
      }
    }
    {
      user: macbook
      password: "{{MACBOOK_TOKEN}}"
      permissions: {
        publish: ["metrics.macbook", "results.>", "$JS.API.>", "_INBOX.>"]
        subscribe: ["$JS.API.>", "$JS.ACK.>", "$JS.FC.>", "_INBOX.>"]
      }
    }
    {
      user: dashboard
      password: "{{DASHBOARD_TOKEN}}"
      permissions: {
        publish: []
        subscribe: ["metrics.>", "results.>"]
      }
    }
  ]
}
